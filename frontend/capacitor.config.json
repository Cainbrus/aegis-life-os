{
  "appId": "com.digitalmate.app",
  "appName": "Digital Mate",
  "webDir": "build",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0f172a",
      "showSpinner": false,
      "androidSpinnerStyle": "small",
      "spinnerColor": "#06b6d4"
    }
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0f172a"
  }
}
